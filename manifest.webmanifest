{
  "name": "Nothi — বাংলা PDF এডিটর",
  "short_name": "Nothi",
  "description": "PDF-এর আসল লেখা ও ছবি এডিট, OCR, ফর্ম, স্বাক্ষর, মার্জ, কমপ্রেস — সবকিছু ব্রাউজারেই।",
  "lang": "bn",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f4ee",
  "theme_color": "#0b5d45",
  "icons": [
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/pdf": [".pdf"] } }
  ]
}
